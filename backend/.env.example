# Copy this file to backend/.env and fill in what you use. backend/.env is git-ignored: keys never leave your machine.

# FreeLLM gateway (local, OpenAI-compatible). When it answers, every citizen uses a strong gateway model for its
# role automatically; when it is down or the key is missing, citizens fall back to their local Ollama models.
FREELLM_API_KEY=
# FREELLM_BASE_URL=http://localhost:3001/v1
# FREELLM_MODEL=            # optional: force one gateway model for everyone (otherwise chosen per role)

# Optional free cloud tiers
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
